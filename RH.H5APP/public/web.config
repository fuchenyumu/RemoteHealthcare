<?xml version="1.0" encoding="UTF-8"?>
<!--
  IIS 配置文件 - H5 App 部署

  支持两种部署模式：

  1. 独立部署模式（默认）
     - H5 App 作为一个独立站点部署
     - 访问路径：https://www.example.com/

  2. 子目录部署模式
     - H5 App 部署在主站点的子目录下
     - 访问路径：https://www.example.com/h5app/

  需要安装 IIS URL Rewrite 模块：
  https://www.iis.net/downloads/microsoft/url-rewrite
-->
<configuration>
  <system.webServer>
    <!-- URL 重写规则 -->
    <rewrite>
      <rules>
        <!-- ==================== 反向代理规则（可选）==================== -->

        <!-- API 代理到后端 HTTP 端口（如果使用 IIS 反向代理） -->
        <!-- 取消注释以下规则以启用 API 代理 -->
        <!--
        <rule name="ReverseProxyApiRule" stopProcessing="true">
          <match url="^api/v1/(.*)" />
          <conditions>
            <add input="{CACHE_URL}" pattern="^(https?)://" />
          </conditions>
          <action type="Rewrite" url="http://localhost:8808/api/v1/{R:1}" />
          <serverVariables>
            <set name="HTTP_X_FORWARDED_PROTO" value="https" />
            <set name="HTTP_X_FORWARDED_HOST" value="{HTTP_HOST}" />
          </serverVariables>
        </rule>
        -->

        <!-- ==================== 静态文件规则 ==================== -->

        <!-- 静态资源直接返回（不转发） -->
        <rule name="StaticAssetsRule" stopProcessing="true">
          <match url="^(assets|images|fonts|css|js)/(.*)" />
          <action type="None" />
        </rule>

        <!-- 配置文件直接返回 -->
        <rule name="ConfigFileRule" stopProcessing="true">
          <match url="^config\.js$" />
          <action type="None" />
        </rule>

        <!-- 单个静态文件（HTML, JS, CSS, 图片, JSON 等） -->
        <rule name="StaticFileExtensionsRule" stopProcessing="true">
          <match url="([\S]+[.]js|[\S]+[.]css|[\S]+[.]json|[\S]+[.]png|[\S]+[.]jpg|[\S]+[.]jpeg|[\S]+[.]gif|[\S]+[.]svg|[\S]+[.]ico|[\S]+[.]woff|[\S]+[.]woff2|[\S]+[.]ttf|[\S]+[.]eot|[\S]+[.]map|[\S]+[.]html|[\S]+[.]txt)$" />
          <action type="None" />
        </rule>

        <!-- ==================== Vue Router 规则 ==================== -->

        <!-- SPA 路由回退（所有非文件请求返回 index.html） -->
        <rule name="SPAFallbackRule" stopProcessing="true">
          <match url=".*" />
          <conditions logicalGrouping="MatchAll">
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
            <add input="{REQUEST_FILENAME}" matchType="IsDirectory" negate="true" />
          </conditions>
          <action type="Rewrite" url="/" />
        </rule>
      </rules>

      <!-- 允许服务器变量（用于转发头信息） -->
      <allowedServerVariables>
        <add name="HTTP_X_FORWARDED_PROTO" />
        <add name="HTTP_X_FORWARDED_HOST" />
      </allowedServerVariables>
    </rewrite>

    <!-- ==================== MIME 类型支持 ==================== -->
    <staticContent>
      <mimeMap fileExtension=".json" mimeType="application/json" />
      <mimeMap fileExtension=".woff" mimeType="application/font-woff" />
      <mimeMap fileExtension=".woff2" mimeType="application/font-woff2" />
      <mimeMap fileExtension=".js" mimeType="application/javascript" />
      <mimeMap fileExtension=".mjs" mimeType="application/javascript" />
      <mimeMap fileExtension=".webmanifest" mimeType="application/manifest+json" />
    </staticContent>

    <!-- ==================== 压缩配置 ==================== -->
    <urlCompression doStaticCompression="true" doDynamicCompression="true" />
    <httpCompression>
      <scheme name="gzip" dll="%Windir%\system32\inetsrv\gzip.dll" />
      <dynamicTypes>
        <add mimeType="text/*" enabled="true" />
        <add mimeType="message/*" enabled="true" />
        <add mimeType="application/x-javascript" enabled="true" />
        <add mimeType="application/javascript" enabled="true" />
        <add mimeType="application/json" enabled="true" />
        <add mimeType="*/*" enabled="false" />
      </dynamicTypes>
      <staticTypes>
        <add mimeType="text/*" enabled="true" />
        <add mimeType="message/*" enabled="true" />
        <add mimeType="application/x-javascript" enabled="true" />
        <add mimeType="application/javascript" enabled="true" />
        <add mimeType="application/json" enabled="true" />
        <add mimeType="*/*" enabled="false" />
      </staticTypes>
    </httpCompression>

    <!-- ==================== 缓存配置 ==================== -->
    <staticContent>
      <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="7.00:00:00" />
    </staticContent>

    <!-- ==================== 默认文档 ==================== -->
    <defaultDocument>
      <files>
        <clear />
        <add value="index.html" />
      </files>
    </defaultDocument>

    <!-- ==================== 错误页面 ==================== -->
    <httpErrors errorMode="Custom" existingResponse="Replace">
      <remove statusCode="404" subStatusCode="-1" />
      <error statusCode="404" path="/index.html" responseMode="ExecuteURL" />
      <remove statusCode="500" subStatusCode="-1" />
      <error statusCode="500" path="/index.html" responseMode="ExecuteURL" />
    </httpErrors>

    <!-- ==================== HTTP 响应头 ==================== -->
    <httpProtocol>
      <customHeaders>
        <!-- 安全头 -->
        <add name="X-Content-Type-Options" value="nosniff" />
        <add name="X-Frame-Options" value="SAMEORIGIN" />
        <add name="X-XSS-Protection" value="1; mode=block" />

        <!-- 移动端优化 -->
        <add name="X-UA-Compatible" value="IE=edge" />

        <!-- CORS（如果需要跨域访问） -->
        <!--
        <add name="Access-Control-Allow-Origin" value="*" />
        <add name="Access-Control-Allow-Methods" value="GET, POST, PUT, DELETE, OPTIONS" />
        <add name="Access-Control-Allow-Headers" value="Content-Type, Authorization, X-Requested-With" />
        -->
      </customHeaders>
    </httpProtocol>

    <!-- ==================== 安全配置 ==================== -->
    <security>
      <requestFiltering>
        <!-- 允许长 URL（防止 URL 过长被拒绝） -->
        <requestLimits maxUrlLength="4096" maxQueryString="4096" />
      </requestFiltering>
    </security>
  </system.webServer>
</configuration>
