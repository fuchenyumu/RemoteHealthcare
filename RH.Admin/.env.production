# 生产环境配置
# 线上环境平台打包路径
VITE_PUBLIC_PATH=/

# 平台基础URL (请根据实际部署环境修改)
VITE_BASE_URL=https://your-domain.com:8828

# 前端访问地址
VITE_WEB_BASE_URL=https://your-domain.com:8848

# API端口
VITE_API_PORT=8828

# 线上环境路由历史模式（Hash模式传"hash"、HTML5模式传"h5"、Hash模式带base参数传"hash,base参数"、HTML5模式带base参数传"h5,base参数"）
VITE_ROUTER_HISTORY=h5

# 是否在打包时使用cdn替换本地库 替换 true 不替换 false
VITE_CDN=false

# 是否启用gzip压缩或brotli压缩
VITE_COMPRESSION=none

# HTTPS配置
VITE_HTTPS_ENABLED=true
