# SFU 服务配置
APP_NAME=remote-consultation-sfu
APP_ENV=Development
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

# CORS配置
CORS_ORIGINS=["https://192.168.1.113:8848","https://localhost:8848","https://127.0.0.1:8848"]
CORS_ALLOW_CREDENTIALS=True
CORS_ALLOW_METHODS=["*"]
CORS_ALLOW_HEADERS=["*"]

# JWT 配置
JWT_SECRET_KEY=remote-healthcare-sfu-secret-key-2024
JWT_ISSUER=yinzhixin-healthcare
JWT_AUDIENCE=medical-rtc
JWT_TTL_SECONDS=3600

# Redis 配置
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_DB=0
REDIS_USE_SSL=False

# 房间配置
MAX_PARTICIPANTS_PER_ROOM=12
ENABLE_RECORDING=False
RECORDING_STORAGE_PATH=./recordings
